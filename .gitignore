# Large generated/synced trees — not source, regenerated by the Makefile
/rpi5-sysroot/
/rpi5-staging/
/deb/

# Source repos — plain independent git clones, not submodules, not tracked by
# this repo at all. Regenerate with `make clone-repos`. Local patches on top
# live in patches/ (tracked) and are applied automatically by the build
# scripts, so this is safe to wipe/re-clone without losing anything.
/repo/

# build logs (regenerated by scripts/*.sh on every run)
*.log

# stray editor/OS files
.DS_Store
*~

# local Claude Code session/tool settings, not project source
/.claude/
